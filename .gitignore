# Big intermediates live in data/ (compute host only) — never committed.
/data/
!/data/.gitkeep

# Model / HF caches, memmaps
*.memmap
*.safetensors
.cache/
hf_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.ipynb_checkpoints/

# artifacts/ IS committed (small: region-series parquet, map export, forecast JSON,
# validation report). Only exclude anything accidentally large that lands there.
/artifacts/*.memmap
/artifacts/embeddings*
# Per-paper region labels (~5.4 MB) co-locate with the small region artifacts so
# series/export find them via one regions_dir, but they're a compute host-only intermediate,
# not a scored artifact (super_region.i16 IS scored and stays committed). CPU-only environment
# pre-approved this belt-and-suspenders ignore in implementation review.
region_labels.i16.npy

# local editor configuration (device-local; never push to the remote)
.claude/
*_LINK.md
