# Regenerable bulk intermediates live in data/ — never committed.
# NB: ignore the CONTENTS, not the dir itself — git never descends into an
# ignored directory, so a negation inside one can never fire.
/data/*
!/data/.gitkeep
# the shape-and-rebuild README IS tracked; document the directory layout and rebuild commands.
!/data/README.md

# Model / HF caches, memmaps
*.memmap
*.safetensors
.cache/
hf_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.ipynb_checkpoints/

# artifacts/ IS committed (small: region-series parquet, map export, forecast JSON,
# validation report). Only exclude anything accidentally large that lands there.
/artifacts/*.memmap
/artifacts/embeddings*
# Per-paper region labels (~5.4 MB) co-locate with the small region artifacts so
# series/export find them via one regions_dir, but they are regenerable intermediates,
# not a scored artifact (super_region.i16 IS scored and stays committed).
region_labels.i16.npy

# Local editor and assistant configuration
.claude/
*_LINK.md

# Their science lives in LIMITATIONS.md + RELATED-WORK.md; originals are kept privately.
notes/

# Build artifacts (pip/twine)
/dist/
/build/

# Personal names screened by scripts/check_public_safe.py. Never committed --
# a public checker that hardcodes the strings it screens for publishes them.
# See .public-safe-names.example.
.public-safe-names

# Generated browser-map exports and local privacy screening rules
/exports/
.public-safe-patterns

# Local workspace configuration
AGENTS.md
CLAUDE.md
BRAIN_LINK.md
.claude/
.codex/
.agents/
